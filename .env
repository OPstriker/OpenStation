# Mac development settings. Read by docker compose and by backend code run
# directly (backend/app/core/config.py reads ../.env).
# The Pi uses .env.pi instead (see .env.pi.example and scripts/deploy-pi.sh).
# Every setting the app reads is in backend/app/core/config.py.

# Enable development behavior (allows the "changethis" password below)
FASTAPI_ENV=development

PROJECT_NAME="Weather Station"

# Postgres
POSTGRES_PASSWORD=changethis
# Used when running backend code on the host (uv run ...); containers get
# their own DATABASE_URL pointing at the db service.
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# --- Collector ---
# No GPIO on the Mac: fake the anemometer with gpiozero's MockFactory.
# (compose.override.yml also forces this for the collector container.)
COLLECTOR_SIMULATE=true
# Fake readings for the simulated collector
SIM_WIND_MPH=8
SIM_PRESSURE_HPA=1013.25
SIM_TEMP_C=21
SIM_CO2_PPM=650
SIM_WIND_DIR_DEG=225
SIM_HUMIDITY_PCT=45
SAMPLE_INTERVAL_S=1.0
COLLECTOR_LOG_EVERY_S=10
# Readings older than this show as "stale" on the dashboard
STALE_AFTER_S=5

# --- KY-025 anemometer (defaults; calibrate on the Pi via .env.pi) ---
ANEMOMETER_ENABLED=true
ANEMOMETER_GPIO=17
ANEMOMETER_ACTIVE_HIGH=true
ANEMOMETER_BOUNCE_S=0.01
ANEMOMETER_MPH_PER_HZ=1.492
ANEMOMETER_PULSES_PER_REV=1
ANEMOMETER_GUST_AVG_S=3
ANEMOMETER_GUST_WINDOW_S=600

# --- Grove Barometer SPA06-003 on I2C ---
BAROMETER_ENABLED=true
# /dev/i2c-<bus>: 1 is the 40-pin header (SDA GPIO2 pin 3, SCL GPIO3 pin 5)
BAROMETER_I2C_BUS=1
# 0x77 is the Grove default; 0x76 if the address pads were changed
BAROMETER_I2C_ADDRESS=0x77
# Reference sea-level pressure for the altitude_m metric
BAROMETER_SEA_LEVEL_HPA=1013.25
# Station elevation in metres; set it to also store sea_level_pressure_hpa
# (the number weather reports show)
# BAROMETER_STATION_ALTITUDE_M=
BAROMETER_RETRY_S=30

# --- Grove CO2 & Temperature & Humidity Sensor, SCD41 (I2C 0x62) ---
# Shares /dev/i2c-1 with the barometer. Power the module from 3.3 V.
AIR_QUALITY_ENABLED=true
AIR_QUALITY_I2C_BUS=1
AIR_QUALITY_I2C_ADDRESS=0x62
# Self-heating correction the sensor subtracts from its temperature (degC).
# Unset keeps the chip's setting (factory default 4).
# AIR_QUALITY_TEMPERATURE_OFFSET_C=4
# Automatic self-calibration assumes the sensor sees fresh air (~400 ppm) at
# least weekly. Unset keeps the chip's setting (factory default on).
# AIR_QUALITY_ASC_ENABLED=true
# Use the barometer's pressure for CO2 pressure compensation
AIR_QUALITY_PRESSURE_COMPENSATION=true
AIR_QUALITY_RETRY_S=30

# --- Wind vane on a KY-040 rotary encoder (see CLAUDE.md "Hardware") ---
# CLK GPIO23 (pin 16), DT GPIO24 (pin 18), SW GPIO22 (pin 15), + 3.3 V, GND.
WIND_VANE_ENABLED=true
WIND_VANE_CLK_GPIO=23
WIND_VANE_DT_GPIO=24
# Push button: point the vane at WIND_VANE_OFFSET_DEG (north) and press it
WIND_VANE_SW_GPIO=22
# KY-040: 20 detents per turn = 18 degrees per step
WIND_VANE_STEPS_PER_REV=20
# Bearing the vane points at when zeroed (collector start or button press)
WIND_VANE_OFFSET_DEG=0
# true if turning the vane clockwise makes the bearing go down
WIND_VANE_INVERT=false
# Window for direction_avg_deg (WMO: 2 minutes)
WIND_VANE_AVG_S=120
